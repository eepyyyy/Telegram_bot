# Telegram Bot Token & API Credentials
TOKEN_API=YOUR_TELEGRAM_BOT_TOKEN
API_ID=YOUR_TELEGRAM_API_ID
API_HASH=YOUR_TELEGRAM_API_HASH

# Local Telegram Bot API Server URL (for Docker use http://telegram-bot-api:8081, for non-docker use http://localhost:8081)
LOCAL_SERVER_URL=http://telegram-bot-api:8081

# Webhook Configuration
WEBHOOK_HOST=https://tbot.eepy.in
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=super_secret_webhook_token_123
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8080

# Channel Backup & Pyrogram Stream Server Config
STORAGE_CHANNEL_ID="-1004423011255"
STREAM_SERVER_URL=https://stream.eepy.in
SERVER_HOST=0.0.0.0
SERVER_PORT=8088

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tbot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tbot

# Idle Optimization & Concurrency Limits
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
WORKER_CONCURRENCY=2
AAC_WORKER_CONCURRENCY=3
ATMOS_WORKER_CONCURRENCY=3

# Admin Dashboard Control Plane Configuration
ADMIN_PASSWORD=eepyadmin123
JWT_SECRET=super_secret_jwt_key_here

